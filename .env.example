# Copy to .env.local (development) or set in your hosting environment. Never commit real secrets.

# Public URL used in emails, payment redirects and deep links (no trailing slash)
APP_URL=http://localhost:3031

# Database — leave empty locally to use the embedded PGlite database in .data/pglite
# AWS RDS / Aurora PostgreSQL example:
# DATABASE_URL=postgres://ringo:password@your-db.xxxxxx.ap-southeast-1.rds.amazonaws.com:5432/ringo
# DATABASE_SSL=require
# DATABASE_POOL_MAX=10
# DATABASE_AUTO_MIGRATE=true

# First super admin (created on start-up if the email does not exist)
# RINGO_ADMIN_EMAIL=owner@example.com
# RINGO_ADMIN_PASSWORD=change-me-1234
# RINGO_ADMIN_NAME=Ringo Admin

# Demo data: auto in development on an empty DB. Force on/off with true/false.
# RINGO_DEMO_SEED=false

# Cookies — secure cookies are on automatically in production (HTTPS required)
# COOKIE_SECURE=true

# File storage — leave empty for local disk (.data/uploads). S3 for production:
# S3_BUCKET=ringo-private-content
# AWS_REGION=ap-southeast-1
# MAX_UPLOAD_MB=200
# UPLOAD_DIR=/var/lib/ringo/uploads

# Email — leave empty to only log emails (Admin → Customer care → Email log). Amazon SES SMTP example:
# SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Ringo <no-reply@your-domain.com>"

# Payments
# Test sandbox is available in development; in production only when explicitly allowed:
# PAYMENT_TEST_MODE=false
# PearPay (fill after contract; set PEARPAY_IMPLEMENTED=true once the API calls are wired)
# PEARPAY_API_BASE_URL=
# PEARPAY_MERCHANT_ID=
# PEARPAY_API_KEY=
# PEARPAY_WEBHOOK_SECRET=
# PEARPAY_IMPLEMENTED=false
# NextPay
# NEXTPAY_API_BASE_URL=
# NEXTPAY_MERCHANT_ID=
# NEXTPAY_API_KEY=
# NEXTPAY_WEBHOOK_SECRET=
# NEXTPAY_IMPLEMENTED=false

# Reporting time zone for dashboards and dates
# REPORT_TIMEZONE=Asia/Manila
# NEXT_PUBLIC_TIMEZONE=Asia/Manila
# CRON_SECRET=long-random-string   # for POST /api/cron/expire-orders
# RINGO_DEMO_LOGIN=false   # 로그인 페이지 테스트 로그인 버튼 (개발 기본 켜짐, 운영 기본 꺼짐)

# 프록시 뒤에서 실제 방문자 IP를 판단할 신뢰 홉 수 (AWS ALB 1개 뒤 = 1, 로컬 = 0). 로그인 시도 제한·로그 IP에 사용
# TRUSTED_PROXY_HOPS=1
